/* Practical I.1 - Drawing pixels
   Borland Turbo C++ / BGI
*/
#include <graphics.h>
#include <conio.h>

int main(void)
{
    int gd = DETECT, gm;
    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");

    if (graphresult() != grOk)
        return 1;

    setbkcolor(WHITE);
    cleardevice();

    putpixel(25, 25, RED);
    putpixel(30, 25, RED);
    putpixel(35, 25, RED);
    putpixel(40, 25, RED);

    getch();
    closegraph();
    return 0;
}
